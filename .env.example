# Copy this file to .env and fill in your own Supabase project values.
# These are safe to expose to the client (Expo "public" env vars) — they are
# the project URL and anon key, not secrets.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The following are NOT used by the app directly — they must be set as
# Supabase Edge Function secrets (`supabase secrets set ...`), never in this
# file or committed anywhere:
#   ANTHROPIC_API_KEY
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
